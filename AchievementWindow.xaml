<Window x:Class="UbiSlot.AchievementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Achievements"
        Icon="/UbiSlot;component/Games/UbiSlot.ico"
        Width="900"
        Height="700"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#101014"
        Foreground="White">

    <Window.Resources>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#3D1B5D"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="18,9"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="#3D1B5D"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#512878"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#2B133F"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#24242C"/>

                                <Setter Property="Foreground"
                                        Value="#777780"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#24242C"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="16,9"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="#24242C"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#34343D"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1C1C22"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="SearchButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="34"/>

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#85858F"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="SearchButtonBackground"
                                Background="Transparent"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="SearchButtonBackground"
                                        Property="Background"
                                        Value="#24242C"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="SearchButtonBackground"
                                        Property="Background"
                                        Value="#34343D"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="AchievementCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#19191F"/>

            <Setter Property="CornerRadius"
                    Value="6"/>

            <Setter Property="Padding"
                    Value="14"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#15151A"
                BorderBrush="#292931"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock x:Name="GameTitleText"
                               Text="Achievements"
                               FontSize="22"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="ProgressText"
                               Text="0/0 unlocked"
                               Margin="0,5,0,0"
                               Foreground="#85858F"
                               FontSize="12"/>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="SearchButton"
                            Click="SearchButton_Click"
                            Style="{StaticResource SearchButtonStyle}">

                        <Grid Width="20"
                              Height="20">

                            <Ellipse Width="12"
                                     Height="12"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Margin="1,1,0,0"
                                     Stroke="White"
                                     StrokeThickness="2"/>

                            <Rectangle Width="8"
                                       Height="2"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="11,13,0,0"
                                       Fill="White"
                                       RadiusX="1"
                                       RadiusY="1"
                                       RenderTransformOrigin="0,0.5">

                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Rectangle.RenderTransform>

                            </Rectangle>

                        </Grid>

                    </Button>

                    <Button x:Name="SelectAllLockedButton"
                            Content="Select All Locked"
                            Width="130"
                            Height="32"
                            Margin="8,0,10,0"
                            Click="SelectAllLockedButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                    <Button Content="Back"
                            Width="80"
                            Height="32"
                            Click="BackButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                </StackPanel>


                <!-- SEARCH POPUP -->

                <Popup x:Name="SearchPopup"
                       PlacementTarget="{Binding ElementName=SearchButton}"
                       Placement="Bottom"
                       HorizontalOffset="-226"
                       VerticalOffset="6"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       Closed="SearchPopup_Closed">

                    <Border Width="260"
                            Height="42"
                            Background="#24242C"
                            BorderBrush="#3D1B5D"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="2">

                        <Border.RenderTransform>

                            <TranslateTransform x:Name="SearchTransform"
                                                Y="-8"/>

                        </Border.RenderTransform>

                        <Border.Triggers>

                            <EventTrigger RoutedEvent="Loaded">

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="SearchTransform"
                                            Storyboard.TargetProperty="Y"
                                            From="-8"
                                            To="0"
                                            Duration="0:0:0.15"/>

                                    </Storyboard>

                                </BeginStoryboard>

                            </EventTrigger>

                        </Border.Triggers>

                        <TextBox x:Name="AchievementSearchBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 FontSize="13"
                                 Padding="10,5"
                                 VerticalContentAlignment="Center"
                                 TextChanged="AchievementSearchBox_TextChanged"/>

                    </Border>

                </Popup>

            </Grid>

        </Border>


        <!-- ACHIEVEMENT LIST -->

        <ScrollViewer Grid.Row="1"
                      Margin="24"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel x:Name="AchievementList"/>

        </ScrollViewer>


        <!-- FOOTER -->

        <Border Grid.Row="2"
                Background="#15151A"
                BorderBrush="#292931"
                BorderThickness="0,1,0,0">

            <Grid Margin="24,0">

                <TextBlock x:Name="SelectionText"
                           Text="0 selected"
                           VerticalAlignment="Center"
                           Foreground="#85858F"
                           FontSize="12"/>

                <Button x:Name="RestoreOriginalButton"
                        Content="Restore Original"
                        Width="130"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="RestoreOriginalButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                <Button x:Name="GetAchievementButton"
                        Content="Get Achievement"
                        Width="150"
                        Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="GetAchievementButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}"/>

            </Grid>

        </Border>

    </Grid>

</Window>