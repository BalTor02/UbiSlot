<Window x:Class="UbiSlot.MainWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Title="UbiSlot"
     Icon="/UbiSlot;component/UI/UbiSlot.ico"
     Width="1200"
     Height="750"
     MinWidth="900"
     MinHeight="600"
     WindowStartupLocation="CenterScreen"
     WindowState="Maximized"
     Background="#101014"
     Foreground="White">

    <Window.Resources>

        <CubicEase x:Key="SearchEase"
               EasingMode="EaseInOut"/>

        <!-- REFRESH BUTTON -->

        <Style x:Key="PrimaryButtonStyle"
           TargetType="{x:Type Button}">

            <Setter Property="Background"
                Value="#3D1B5D"/>

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="Padding"
                Value="18,9"/>

            <Setter Property="FontSize"
                Value="13"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Focusable"
                Value="False"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBackground"
                            Background="#3D1B5D"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="ButtonBackground"
                                    Property="Background"
                                    Value="#512878"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="ButtonBackground"
                                    Property="Background"
                                    Value="#2B133F"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- SEARCH BUTTON -->

        <Style x:Key="SearchButtonStyle"
           TargetType="{x:Type Button}">

            <Setter Property="Width"
                Value="34"/>

            <Setter Property="Height"
                Value="34"/>

            <Setter Property="Background"
                Value="Transparent"/>

            <Setter Property="Foreground"
                Value="#85858F"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Focusable"
                Value="False"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="SearchButtonBackground"
                            Background="Transparent"
                            CornerRadius="6">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="SearchButtonBackground"
                                    Property="Background"
                                    Value="#24242C"/>

                                <Setter Property="Foreground"
                                    Value="White"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="SearchButtonBackground"
                                    Property="Background"
                                    Value="#34343D"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- GAME CARDS -->

        <Style x:Key="GameButtonStyle"
   TargetType="{x:Type Button}">

            <Setter Property="Background"
        Value="Transparent"/>

            <Setter Property="BorderBrush"
        Value="Transparent"/>

            <Setter Property="BorderThickness"
        Value="0"/>

            <Setter Property="Padding"
        Value="0"/>

            <Setter Property="Margin"
        Value="6,8,6,20"/>

            <Setter Property="HorizontalContentAlignment"
        Value="Center"/>

            <Setter Property="VerticalContentAlignment"
        Value="Top"/>

            <Setter Property="Cursor"
        Value="Hand"/>

            <Setter Property="FocusVisualStyle"
        Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- PILL SCROLLBAR -->

        <Style x:Key="PillScrollBarBaseStyle"
           TargetType="{x:Type ScrollBar}">

            <Setter Property="Width"
                Value="9"/>

            <Setter Property="Background"
                Value="Transparent"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ScrollBar}">

                        <Grid Width="9"
                          Background="Transparent">

                            <Track x:Name="PART_Track"
                               Focusable="False"
                               IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                    Command="ScrollBar.PageUpCommand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Opacity="0"
                                    IsTabStop="False"/>

                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>

                                    <Thumb
                                    MinHeight="38"
                                    Background="#3D1B5D"
                                    BorderThickness="0"
                                    Opacity="0.9">

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="{x:Type Thumb}">

                                                <Border
                                                x:Name="ThumbBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Margin="1,0"/>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                         Value="True">

                                                        <Setter TargetName="ThumbBorder"
                                                            Property="Background"
                                                            Value="#512878"/>

                                                    </Trigger>

                                                    <Trigger Property="IsDragging"
                                                         Value="True">

                                                        <Setter TargetName="ThumbBorder"
                                                            Property="Background"
                                                            Value="#512878"/>

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                    Command="ScrollBar.PageDownCommand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Opacity="0"
                                    IsTabStop="False"/>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- SEARCH BOX -->

        <Style x:Key="SearchBoxStyle"
           TargetType="{x:Type TextBox}">

            <Setter Property="Background"
                Value="#24242C"/>

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="BorderBrush"
                Value="#3D1B5D"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="Padding"
                Value="12,7"/>

            <Setter Property="FontSize"
                Value="13"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter Property="FocusVisualStyle"
                Value="{x:Null}"/>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Border Grid.Row="0"
            BorderBrush="#0F0A14"
            BorderThickness="0,0,0,1"
            Panel.ZIndex="2">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0"
                                  EndPoint="1,0">

                    <GradientStop Color="#1B1420"
                              Offset="0"/>

                    <GradientStop Color="#241A2E"
                              Offset="0.5"/>

                    <GradientStop Color="#1B1420"
                              Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

            <Grid Margin="24,0,28,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- WORDMARK -->

                <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                    <Image Source="/UbiSlot;component/UI/UbiSlot_logo.png"
                       Width="30"
                       Height="30"
                       Margin="0,0,12,0"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center">

                        <TextBlock FontSize="21"
                               FontWeight="Bold">
                        <Run Text="Ubi"
                             Foreground="White"/><Run Text="Slot"
                             Foreground="#B98CFF"/>
                        </TextBlock>

                        <TextBlock Text="UBISOFT ACHIEVEMENT UNLOCKER"
                               Margin="0,2,0,0"
                               Foreground="#7A7482"
                               FontSize="10"
                               FontWeight="SemiBold"/>

                    </StackPanel>

                </StackPanel>

                <!-- TOOLBAR -->

                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                    <Border Width="1"
                        Height="28"
                        Background="#332A3D"
                        Margin="0,0,14,0"/>

                    <Button x:Name="SearchButton"
                        Click="SearchButton_Click"
                        Width="34"
                        Height="34"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Focusable="False"
                        ToolTip="Search">

                        <Button.Template>

                            <ControlTemplate TargetType="{x:Type Button}">

                                <Border Background="Transparent"
                                    CornerRadius="6">

                                    <Grid x:Name="SearchIcon"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">

                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="SearchScale"
                                                        ScaleX="1"
                                                        ScaleY="1"/>
                                        </Grid.RenderTransform>

                                        <Path Fill="Transparent"
                                          Stroke="#666670"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Stretch="Fill"
                                          Data="M 7.5,1.5
                                                A 6,6 0 1 0 7.5,13.5
                                                A 6,6 0 1 0 7.5,1.5
                                                M 11.8,11.8
                                                L 16.5,16.5"/>

                                    </Grid>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <EventTrigger RoutedEvent="MouseEnter">

                                        <BeginStoryboard Name="SearchZoomStoryboard">

                                            <Storyboard>

                                                <DoubleAnimation
                                                Storyboard.TargetName="SearchScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                From="1"
                                                To="1.10"
                                                Duration="0:0:0.28"
                                                AutoReverse="True"
                                                RepeatBehavior="Forever"
                                                EasingFunction="{StaticResource SearchEase}"/>

                                                <DoubleAnimation
                                                Storyboard.TargetName="SearchScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                From="1"
                                                To="1.10"
                                                Duration="0:0:0.28"
                                                AutoReverse="True"
                                                RepeatBehavior="Forever"
                                                EasingFunction="{StaticResource SearchEase}"/>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </EventTrigger>

                                    <EventTrigger RoutedEvent="MouseLeave">

                                        <StopStoryboard
                                        BeginStoryboardName="SearchZoomStoryboard"/>

                                    </EventTrigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    <Button x:Name="RefreshButton"
    Click="RefreshButton_Click"
    Width="26"
    Height="26"
    Margin="8,0,0,0"
    Background="Transparent"
    BorderThickness="0"
    Cursor="Hand"
    Focusable="False"
    ToolTip="Refresh">

                        <Button.Template>

                            <ControlTemplate TargetType="{x:Type Button}">

                                <Border Background="Transparent"
                CornerRadius="5">

                                    <Grid x:Name="RefreshIcon"
                  Width="18"
                  Height="18"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">

                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="RefreshRotation"
                                     Angle="0"/>
                                        </Grid.RenderTransform>

                                        <!-- VECTOR REFRESH ARROW -->
                                        <Path Fill="#666670"
                      Stretch="Fill"
                      Data="
                        M 15.8,4.3
                        C 14.2,2.7 11.9,1.8 9.4,1.8
                        C 5.1,1.8 1.7,5.0 1.7,9.0
                        C 1.7,13.1 5.1,16.2 9.4,16.2
                        C 12.0,16.2 14.3,15.1 15.8,13.1
                        L 13.3,11.5
                        C 12.3,12.9 11.0,13.6 9.4,13.6
                        C 6.5,13.6 4.2,11.5 4.2,9.0
                        C 4.2,6.5 6.5,4.4 9.4,4.4
                        C 10.8,4.4 12.1,4.9 13.1,5.9
                        L 11.0,7.1
                        L 16.8,8.0
                        L 16.8,2.2
                        Z"/>

                                    </Grid>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <EventTrigger RoutedEvent="MouseEnter">

                                        <BeginStoryboard Name="RefreshSpinStoryboard">

                                            <Storyboard>

                                                <DoubleAnimation
                            Storyboard.TargetName="RefreshRotation"
                            Storyboard.TargetProperty="Angle"
                            From="0"
                            To="360"
                            Duration="0:0:2"
                            RepeatBehavior="Forever"/>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </EventTrigger>


                                    <EventTrigger RoutedEvent="MouseLeave">

                                        <StopStoryboard
                    BeginStoryboardName="RefreshSpinStoryboard"/>

                                    </EventTrigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </StackPanel>


                <!-- SEARCH POPUP -->

                <Popup x:Name="SearchPopup"
                    PlacementTarget="{Binding ElementName=SearchButton}"
                    Placement="Bottom"
                    HorizontalOffset="-226"
                    VerticalOffset="6"
                    AllowsTransparency="True"
                    StaysOpen="True"
                    Closed="SearchPopup_Closed">

                    <Border Width="260"
                        Height="42"
                        Background="#24242C"
                        BorderBrush="#3D1B5D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="2">

                        <Border.RenderTransform>

                            <TranslateTransform x:Name="SearchTransform"
                                            Y="-8"/>

                        </Border.RenderTransform>

                        <Border.Triggers>

                            <EventTrigger RoutedEvent="Loaded">

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation
                                        Storyboard.TargetName="SearchTransform"
                                        Storyboard.TargetProperty="Y"
                                        From="-8"
                                        To="0"
                                        Duration="0:0:0.15"/>

                                    </Storyboard>

                                </BeginStoryboard>

                            </EventTrigger>

                        </Border.Triggers>

                        <TextBox x:Name="GameSearchBox"
                             KeyDown="GameSearchBox_KeyDown"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="White"
                             FontSize="13"
                             Padding="10,5"
                             VerticalContentAlignment="Center"
                             TextChanged="GameSearchBox_TextChanged"/>

                    </Border>

                </Popup>

            </Grid>

        </Border>

        <Border Grid.Row="1"
            Height="60"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Panel.ZIndex="1">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0"
                                  EndPoint="0,1">

                    <GradientStop Color="#3A9D5CFF"
                              Offset="0"/>

                    <GradientStop Color="#1C9D5CFF"
                              Offset="0.25"/>

                    <GradientStop Color="#0A9D5CFF"
                              Offset="0.55"/>

                    <GradientStop Color="#009D5CFF"
                              Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

        </Border>

        <Border Grid.Row="1"
            Height="40"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Panel.ZIndex="1">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0"
                                  EndPoint="0,1">

                    <GradientStop Color="#009D5CFF"
                              Offset="0"/>

                    <GradientStop Color="#0A9D5CFF"
                              Offset="0.45"/>

                    <GradientStop Color="#1C9D5CFF"
                              Offset="0.78"/>

                    <GradientStop Color="#289D5CFF"
                              Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

        </Border>


        <!-- MAIN CONTENT -->

        <Grid Grid.Row="1"
          Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Grid Grid.Row="0"
  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Your Games"
               FontSize="22"
               FontWeight="SemiBold"/>

                    <TextBlock x:Name="GameCountText"
               Text="Scanning..."
               Margin="0,6,0,0"
               Foreground="#85858F"
               FontSize="13"/>

                </StackPanel>

                <TextBlock x:Name="GameRunningText"
           Grid.Column="1"
           VerticalAlignment="Center"
           Margin="30,0,0,0"
           Foreground="#FF7F50"
           FontSize="13"
           FontWeight="SemiBold"
           TextAlignment="Right"
           Visibility="Collapsed"/>

            </Grid>


            <ScrollViewer x:Name="GameScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Margin="0,0,0,0"
                        ScrollChanged="GameScrollViewer_ScrollChanged">


                <ScrollViewer.Resources>

                    <Style TargetType="{x:Type ScrollBar}"
                        BasedOn="{StaticResource PillScrollBarBaseStyle}"/>

                </ScrollViewer.Resources>

                <StackPanel HorizontalAlignment="Stretch">

                    <UniformGrid x:Name="GameGrid"
                             Columns="5"
                             HorizontalAlignment="Stretch"/>

                    <Border x:Name="DisclaimerContainer"
                        Margin="0,18,0,18"
                        Padding="20,14"
                        HorizontalAlignment="Stretch"
                        Opacity="0"
                        IsHitTestVisible="False">

                        <TextBlock x:Name="DisclaimerText"
                               Text="All game titles, cover art, logos, and other imagery displayed within UbiSlot are trademarks and/or copyrighted materials of their respective owners, including Ubisoft Entertainment. UbiSlot is an independent, third-party application and is not affiliated with, sponsored by, or endorsed by Ubisoft Entertainment or any publisher or developer whose content may appear within the app. All such materials are used solely for identification and informational purposes."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="900"
                               Foreground="#666670"
                               FontSize="11"/>

                    </Border>

                </StackPanel>

            </ScrollViewer>
        </Grid>


        <!-- FOOTER -->

        <Border Grid.Row="2"
            BorderBrush="#332A3D"
            BorderThickness="0,1,0,0"
            Panel.ZIndex="2">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0"
                                  EndPoint="1,0">

                    <GradientStop Color="#1B1420"
                              Offset="0"/>

                    <GradientStop Color="#241A2E"
                              Offset="0.5"/>

                    <GradientStop Color="#1B1420"
                              Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

            <Grid Margin="28,0">

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                    <Ellipse Width="7"
                         Height="7"
                         Margin="0,0,7,0"
                         Fill="#7C4DD8"/>

                    <TextBlock x:Name="StatusText"
                           Text="Ready"
                           VerticalAlignment="Center"
                           Foreground="#9A93A3"
                           FontSize="11"/>

                </StackPanel>


                <Button Content="Support"
                    Click="SupportButton_Click"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Foreground="#9A93A3"
                    BorderThickness="0"
                    Padding="10,5"
                    FontSize="11"
                    Cursor="Hand"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="SupportBackground"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="SupportContent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                     Value="True">
                                    <Setter TargetName="SupportBackground"
                                        Property="Background"
                                        Value="#24242C"/>
                                    <Setter Property="Foreground"
                                        Value="#C9A9FF"/>
                                    <Setter TargetName="SupportContent"
                                        Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#B98CFF"
                                                           BlurRadius="16"
                                                           ShadowDepth="0"
                                                           Opacity="0.9"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>


                <StackPanel Orientation="Horizontal"
        HorizontalAlignment="Right"
        VerticalAlignment="Center">

                    <!-- VERSION -->
                    <TextBlock Text="UbiSlot v0.3-beta"
           VerticalAlignment="Center"
           Foreground="#7A7482"
           FontSize="11"/>

                    <!-- SETTINGS -->
                    <Button x:Name="SettingsButton"
        Click="SettingsButton_Click"
        Width="26"
        Height="26"
        Margin="8,0,0,0"
        Background="Transparent"
        BorderThickness="0"
        Cursor="Hand"
        Focusable="False"
        ToolTip="Settings">

                        <Button.Template>

                            <ControlTemplate TargetType="{x:Type Button}">

                                <Border Background="Transparent"
                    CornerRadius="5">

                                    <Grid x:Name="GearIcon"
                                  Width="18"
                                  Height="18"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">

                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="GearRotation"
                                                         Angle="0"/>
                                        </Grid.RenderTransform>

                                        <Path Fill="#666670"
                                          Stretch="Fill"
                                          Data="M 8.2,0
                                                L 11.8,0
                                                L 12.2,2.2
                                                C 12.8,2.35 13.35,2.55 13.85,2.85
                                                L 15.65,1.5
                                                L 18.2,4.05
                                                L 16.85,5.85
                                                C 17.15,6.35 17.35,6.9 17.5,7.5
                                                L 19.8,7.9
                                                L 19.8,11.5
                                                L 17.5,11.9
                                                C 17.35,12.5 17.15,13.05 16.85,13.55
                                                L 18.2,15.35
                                                L 15.65,17.9
                                                L 13.85,16.55
                                                C 13.35,16.85 12.8,17.05 12.2,17.2
                                                L 11.8,19.4
                                                L 8.2,19.4
                                                L 7.8,17.2
                                                C 7.2,17.05 6.65,16.85 6.15,16.55
                                                L 4.35,17.9
                                                L 1.8,15.35
                                                L 3.15,13.55
                                                C 2.85,13.05 2.65,12.5 2.5,11.9
                                                L 0.2,11.5
                                                L 0.2,7.9
                                                L 2.5,7.5
                                                C 2.65,6.9 2.85,6.35 3.15,5.85
                                                L 1.8,4.05
                                                L 4.35,1.5
                                                L 6.15,2.85
                                                C 6.65,2.55 7.2,2.35 7.8,2.2
                                                Z"/>

                                        <Ellipse Width="7"
                                             Height="7"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Fill="#15151A"/>

                                    </Grid>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <EventTrigger RoutedEvent="MouseEnter">

                                        <BeginStoryboard Name="GearSpinStoryboard">

                                            <Storyboard>

                                                <DoubleAnimation
                Storyboard.TargetName="GearRotation"
                Storyboard.TargetProperty="Angle"
                                From="0"
                                To="360"
                                Duration="0:0:2"
                                RepeatBehavior="Forever"/>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </EventTrigger>


                                    <EventTrigger RoutedEvent="MouseLeave">

                                        <StopStoryboard
        BeginStoryboardName="GearSpinStoryboard"/>

                                    </EventTrigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </StackPanel>
            </Grid>

        </Border>

    </Grid>

</Window>