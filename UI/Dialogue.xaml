<Window x:Class="UbiSlot.Dialogue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UbiSlot"
        Icon="/UbiSlot;component/UI/UbiSlot.ico"
        Width="640"
        Height="520"
        MinWidth="640"
        MinHeight="520"
        MaxWidth="640"
        MaxHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- COLORS - MATCH MAIN / ACHIEVEMENT / SETTINGS WINDOWS   -->

        <SolidColorBrush x:Key="WindowBackground"
                         Color="#101014"/>

        <SolidColorBrush x:Key="PanelBackground"
                         Color="#15151A"/>

        <SolidColorBrush x:Key="FieldBackground"
                         Color="#24242C"/>

        <SolidColorBrush x:Key="HoverBackground"
                         Color="#34343D"/>

        <SolidColorBrush x:Key="PressedBackground"
                         Color="#1C1C22"/>

        <SolidColorBrush x:Key="BorderColor"
                         Color="#332A3D"/>

        <SolidColorBrush x:Key="AccentColor"
                         Color="#3D1B5D"/>

        <SolidColorBrush x:Key="AccentHoverColor"
                         Color="#512878"/>

        <SolidColorBrush x:Key="AccentPressedColor"
                         Color="#2B133F"/>

        <SolidColorBrush x:Key="PrimaryText"
                         Color="#F2F2F5"/>

        <SolidColorBrush x:Key="SecondaryText"
                         Color="#9A93A3"/>

        <SolidColorBrush x:Key="MutedText"
                         Color="#7A7482"/>

        <SolidColorBrush x:Key="DisabledText"
                         Color="#777780"/>

        <LinearGradientBrush x:Key="HeaderFooterGradient"
                              StartPoint="0,0"
                              EndPoint="1,0">
            <GradientStop Color="#1B1420"
                          Offset="0"/>
            <GradientStop Color="#241A2E"
                          Offset="0.5"/>
            <GradientStop Color="#1B1420"
                          Offset="1"/>
        </LinearGradientBrush>


        <!-- PRIMARY ACTION BUTTON   -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="100"/>

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Background"
                    Value="{DynamicResource AccentColor}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource AccentColor}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentHoverColor}"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#B98CFF"
                                                           BlurRadius="14"
                                                           ShadowDepth="0"
                                                           Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentPressedColor}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource FieldBackground}"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BorderColor}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource DisabledText}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- SECONDARY BUTTON                                       -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="100"/>

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Background"
                    Value="{DynamicResource FieldBackground}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryText}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderColor}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentHoverColor}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource PressedBackground}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid Background="{DynamicResource WindowBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>


        <!-- HEADER                -->

        <Border Grid.Row="0"
                Background="{StaticResource HeaderFooterGradient}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Panel.ZIndex="2">

            <Grid Margin="24,0">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- VIOLET ACCENT BAR, MY SIGN LOOK -->
                    <Border Width="3"
                            Height="22"
                            CornerRadius="2"
                            Margin="0,0,12,0">

                        <Border.Background>

                            <LinearGradientBrush StartPoint="0,0"
                                                  EndPoint="0,1">

                                <GradientStop Color="#B98CFF"
                                              Offset="0"/>

                                <GradientStop Color="#7C4DD8"
                                              Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>

                    </Border>

                    <TextBlock x:Name="DialogTitleText"
                               Text="Confirm"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F2F2F5"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- HEADER GLOW             -->

        <Border Grid.Row="1"
                Height="32"
                VerticalAlignment="Top"
                IsHitTestVisible="False">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0"
                                      EndPoint="0,1">

                    <GradientStop Color="#3A9D5CFF"
                                  Offset="0"/>

                    <GradientStop Color="#1C9D5CFF"
                                  Offset="0.25"/>

                    <GradientStop Color="#0A9D5CFF"
                                  Offset="0.55"/>

                    <GradientStop Color="#009D5CFF"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

        </Border>


        <!-- FOOTER GLOW                  -->

        <Border Grid.Row="1"
                Height="24"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0"
                                      EndPoint="0,1">

                    <GradientStop Color="#009D5CFF"
                                  Offset="0"/>

                    <GradientStop Color="#0A9D5CFF"
                                  Offset="0.45"/>

                    <GradientStop Color="#1C9D5CFF"
                                  Offset="0.78"/>

                    <GradientStop Color="#289D5CFF"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

        </Border>

        <!-- BODY                                        -->

        <Border Grid.Row="1"
                Background="Transparent"
                Padding="24,20">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="64"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ICON -->

                <Border x:Name="DialogIconBorder"
                        Grid.Column="0"
                        Width="46"
                        Height="46"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        CornerRadius="23"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        Background="#6B4D10">

                    <TextBlock x:Name="DialogIconText"
                               Text="!"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>

                </Border>


                <!-- MESSAGE -->

                <TextBlock x:Name="DialogMessageText"
                           Grid.Column="1"
                           Text="Message"
                           FontSize="13"
                           LineHeight="20"
                           Foreground="{DynamicResource PrimaryText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"/>

            </Grid>

        </Border>


        <!-- FOOTER                                                  -->

        <Border Grid.Row="2"
                Background="{StaticResource HeaderFooterGradient}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0"
                Panel.ZIndex="2">

            <Grid Margin="24,0">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Click="CancelButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed"/>

                    <Button x:Name="PrimaryButton"
                            Content="OK"
                            Margin="8,0,0,0"
                            Click="PrimaryButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>