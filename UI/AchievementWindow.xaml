<Window x:Class="UbiSlot.AchievementWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Title="Achievements"
     Icon="/UbiSlot;component/UI/UbiSlot.ico"
     Width="900"
     Height="700"
     MinWidth="700"
     MinHeight="500"
     WindowStartupLocation="CenterOwner"
     Background="{DynamicResource WindowBackground}"
     Foreground="{DynamicResource PrimaryText}">

    <Window.Resources>

        <CubicEase x:Key="SearchEase"
                   EasingMode="EaseInOut"/>

        <SolidColorBrush x:Key="WindowBackground"
                         Color="#101014"/>
        <SolidColorBrush x:Key="PanelBackground"
                         Color="#15151A"/>
        <SolidColorBrush x:Key="CardBackground"
                         Color="#19191F"/>
        <SolidColorBrush x:Key="FieldBackground"
                         Color="#24242C"/>
        <SolidColorBrush x:Key="BorderColor"
                         Color="#332A3D"/>
        <SolidColorBrush x:Key="PrimaryText"
                         Color="#F2F2F5"/>
        <SolidColorBrush x:Key="SecondaryText"
                         Color="#9A93A3"/>
        <SolidColorBrush x:Key="MutedText"
                         Color="#7A7482"/>
        <SolidColorBrush x:Key="DisabledText"
                         Color="#777780"/>
        <SolidColorBrush x:Key="HoverBackground"
                         Color="#24242C"/>
        <SolidColorBrush x:Key="PressedBackground"
                         Color="#1C1C22"/>
        <SolidColorBrush x:Key="AccentColor"
                         Color="#3D1B5D"/>
        <SolidColorBrush x:Key="AccentHoverColor"
                         Color="#512878"/>
        <SolidColorBrush x:Key="AccentPressedColor"
                         Color="#2B133F"/>
        <SolidColorBrush x:Key="IconColor"
                         Color="#666670"/>
        <SolidColorBrush x:Key="SuccessText"
                         Color="#50BE78"/>

        <DropShadowEffect x:Key="GameTitleGlow"
                           Color="#3D1B5D"
                           BlurRadius="2"
                           ShadowDepth="0"
                           Opacity="0.75"/>

        <LinearGradientBrush x:Key="HeaderFooterGradient"
                              StartPoint="0,0"
                              EndPoint="1,0">
            <GradientStop Color="#1B1420"
                          Offset="0"/>
            <GradientStop Color="#241A2E"
                          Offset="0.5"/>
            <GradientStop Color="#1B1420"
                          Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="PrimaryButtonStyle"
           TargetType="Button">

            <Setter Property="Background"
                Value="{DynamicResource AccentColor}"/>

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="Padding"
                Value="18,9"/>

            <Setter Property="FontSize"
                Value="13"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                            Background="{DynamicResource AccentColor}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource AccentHoverColor}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource AccentPressedColor}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                 Value="False">

                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource FieldBackground}"/>

                                <Setter Property="Foreground"
                                    Value="{DynamicResource DisabledText}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="SecondaryButtonStyle"
           TargetType="Button">

            <Setter Property="Background"
                Value="{DynamicResource FieldBackground}"/>

            <Setter Property="Foreground"
                Value="{DynamicResource PrimaryText}"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="BorderBrush"
                Value="{DynamicResource BorderColor}"/>

            <Setter Property="Padding"
                Value="16,9"/>

            <Setter Property="FontSize"
                Value="13"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                            Background="{DynamicResource FieldBackground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#34343D"/>

                                <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentHoverColor}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#1C1C22"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="SortOptionButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="Margin"
                    Value="0,2"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryText}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="SortOptionBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="SortOptionBorder"
                                        Property="Background"
                                        Value="{DynamicResource FieldBackground}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="SortOptionBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentColor}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="SearchButtonStyle"
           TargetType="Button">

            <Setter Property="Width"
                Value="34"/>

            <Setter Property="Height"
                Value="34"/>

            <Setter Property="Background"
                Value="Transparent"/>

            <Setter Property="Foreground"
                Value="#85858F"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Focusable"
                Value="False"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="SearchButtonBackground"
                            Background="Transparent"
                            CornerRadius="6">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="SearchButtonBackground"
                                    Property="Background"
                                    Value="#24242C"/>

                                <Setter Property="Foreground"
                                    Value="White"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="SearchButtonBackground"
                                    Property="Background"
                                    Value="#34343D"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="AchievementCardStyle"
           TargetType="Border">

            <Setter Property="Background"
                Value="{DynamicResource CardBackground}"/>

            <Setter Property="BorderBrush"
                Value="{DynamicResource BorderColor}"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="CornerRadius"
                Value="12"/>

            <Setter Property="Padding"
                Value="14"/>

            <Setter Property="Margin"
                Value="0,0,0,12"/>

        </Style>

        <Style x:Key="PillScrollBarBaseStyle"
               TargetType="{x:Type ScrollBar}">

            <Setter Property="Width"
                    Value="9"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ScrollBar}">

                        <Grid Width="9"
                              Background="Transparent">

                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                        Command="ScrollBar.PageUpCommand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0"
                                        IsTabStop="False"/>

                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>

                                    <Thumb
                                        MinHeight="38"
                                        Background="{DynamicResource AccentColor}"
                                        BorderThickness="0"
                                        Opacity="0.9">

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="{x:Type Thumb}">

                                                <Border
                                                    x:Name="ThumbBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Margin="1,0"/>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">

                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="{DynamicResource AccentHoverColor}"/>

                                                    </Trigger>

                                                    <Trigger Property="IsDragging"
                                                             Value="True">

                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="{DynamicResource AccentHoverColor}"/>

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                        Command="ScrollBar.PageDownCommand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0"
                                        IsTabStop="False"/>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>




    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Border Grid.Row="0"
            Background="{StaticResource HeaderFooterGradient}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="0,0,0,1"
            Panel.ZIndex="2">

            <Grid Margin="24,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock x:Name="GameTitleText"
                           Text="Achievements"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           Effect="{StaticResource GameTitleGlow}"/>

                    <TextBlock x:Name="ProgressText"
                           Text="0/0 unlocked"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="12"/>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                    <Button x:Name="SearchButton"
                            Click="SearchButton_Click"
                            Width="34"
                            Height="34"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False"
                            ToolTip="Search">

                        <Button.Template>

                            <ControlTemplate TargetType="{x:Type Button}">

                                <Border Background="Transparent"
                                        CornerRadius="6">

                                    <Grid x:Name="SearchIcon"
                                          Width="18"
                                          Height="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">

                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="SearchScale"
                                                            ScaleX="1"
                                                            ScaleY="1"/>
                                        </Grid.RenderTransform>

                                        <Path x:Name="SearchPath"
                                              Fill="Transparent"
                                              Stroke="{DynamicResource IconColor}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stretch="Fill"
                                              Data="M 7.5,1.5
                                                    A 6,6 0 1 0 7.5,13.5
                                                    A 6,6 0 1 0 7.5,1.5
                                                    M 11.8,11.8
                                                    L 16.5,16.5"/>

                                    </Grid>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver"
                                             Value="True">

                                        <Setter TargetName="SearchPath"
                                                Property="Stroke"
                                                Value="{DynamicResource PrimaryText}"/>

                                    </Trigger>

                                    <EventTrigger RoutedEvent="MouseEnter">

                                        <BeginStoryboard Name="SearchZoomStoryboard">

                                            <Storyboard>

                                                <DoubleAnimation
                                                    Storyboard.TargetName="SearchScale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    From="1"
                                                    To="1.10"
                                                    Duration="0:0:0.28"
                                                    AutoReverse="True"
                                                    RepeatBehavior="Forever"
                                                    EasingFunction="{StaticResource SearchEase}"/>

                                                <DoubleAnimation
                                                    Storyboard.TargetName="SearchScale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    From="1"
                                                    To="1.10"
                                                    Duration="0:0:0.28"
                                                    AutoReverse="True"
                                                    RepeatBehavior="Forever"
                                                    EasingFunction="{StaticResource SearchEase}"/>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </EventTrigger>

                                    <EventTrigger RoutedEvent="MouseLeave">

                                        <StopStoryboard
                                            BeginStoryboardName="SearchZoomStoryboard"/>

                                    </EventTrigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    <Border Width="1"
                            Height="26"
                            Background="{DynamicResource BorderColor}"
                            Margin="10,0"/>

                    <Button x:Name="SortButton"
                            Content="Sort"
                            Width="82"
                            Height="36"
                            Margin="0,0,10,0"
                            Click="SortButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                    <Button x:Name="SelectAllLockedButton"
                            Content="Select All Locked"
                            Width="150"
                            Height="36"
                            Click="SelectAllLockedButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                </StackPanel>

                <!-- SEARCH POPUP -->

                <Popup x:Name="SearchPopup"
                   PlacementTarget="{Binding ElementName=SearchButton}"
                   Placement="Bottom"
                   HorizontalOffset="-226"
                   VerticalOffset="6"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   Closed="SearchPopup_Closed">

                    <Border Width="260"
                        Height="42"
                        Background="{DynamicResource FieldBackground}"
                        BorderBrush="{DynamicResource AccentColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="2">

                        <Border.RenderTransform>

                            <TranslateTransform x:Name="SearchTransform"
                                            Y="-8"/>

                        </Border.RenderTransform>

                        <Border.Triggers>

                            <EventTrigger RoutedEvent="Loaded">

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation
                                        Storyboard.TargetName="SearchTransform"
                                        Storyboard.TargetProperty="Y"
                                        From="-8"
                                        To="0"
                                        Duration="0:0:0.15"/>

                                    </Storyboard>

                                </BeginStoryboard>

                            </EventTrigger>

                        </Border.Triggers>

                        <TextBox x:Name="AchievementSearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource PrimaryText}"
                             FontSize="13"
                             Padding="10,5"
                             VerticalContentAlignment="Center"
                             TextChanged="AchievementSearchBox_TextChanged"/>

                    </Border>

                </Popup>

                <!-- SORT POPUP -->

                <Popup x:Name="SortPopup"
                       PlacementTarget="{Binding ElementName=SortButton}"
                       Placement="Bottom"
                       HorizontalOffset="-54"
                       VerticalOffset="8"
                       AllowsTransparency="True"
                       StaysOpen="False">

                    <Border Width="190"
                            Background="{DynamicResource PanelBackground}"
                            BorderBrush="{DynamicResource AccentColor}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8">

                        <StackPanel>

                            <TextBlock Text="Sort achievements by"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Margin="8,4,8,8"/>

                            <Button Content="Name"
                                    Tag="Name"
                                    Click="SortOption_Click"
                                    Style="{StaticResource SortOptionButtonStyle}"/>

                            <Button Content="ID"
                                    Tag="ID"
                                    Click="SortOption_Click"
                                    Style="{StaticResource SortOptionButtonStyle}"/>

                            <Button Content="Date Achieved"
                                    Tag="DateAchieved"
                                    Click="SortOption_Click"
                                    Style="{StaticResource SortOptionButtonStyle}"/>

                            <Button Content="Locked"
                                    Tag="Locked"
                                    Click="SortOption_Click"
                                    Style="{StaticResource SortOptionButtonStyle}"/>

                            <Button Content="Unlocked"
                                    Tag="Unlocked"
                                    Click="SortOption_Click"
                                    Style="{StaticResource SortOptionButtonStyle}"/>

                        </StackPanel>

                    </Border>

                </Popup>

            </Grid>

        </Border>


        <!-- HEADER GLOW -->

        <Border Grid.Row="1"
                Height="50"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Panel.ZIndex="1">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0"
                                      EndPoint="0,1">

                    <GradientStop Color="#3A9D5CFF"
                                  Offset="0"/>

                    <GradientStop Color="#1C9D5CFF"
                                  Offset="0.25"/>

                    <GradientStop Color="#0A9D5CFF"
                                  Offset="0.55"/>

                    <GradientStop Color="#009D5CFF"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

        </Border>


        <!-- FOOTER GLOW -->

        <Border Grid.Row="1"
                Height="36"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                Panel.ZIndex="1">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0"
                                      EndPoint="0,1">

                    <GradientStop Color="#009D5CFF"
                                  Offset="0"/>

                    <GradientStop Color="#0A9D5CFF"
                                  Offset="0.45"/>

                    <GradientStop Color="#1C9D5CFF"
                                  Offset="0.78"/>

                    <GradientStop Color="#289D5CFF"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

        </Border>


        <!-- ACHIEVEMENT LIST -->

        <ScrollViewer Grid.Row="1"
                  Margin="24"
                  Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

            <ScrollViewer.Resources>

                <Style TargetType="{x:Type ScrollBar}"
                       BasedOn="{StaticResource PillScrollBarBaseStyle}"/>

            </ScrollViewer.Resources>

            <StackPanel x:Name="AchievementList"/>

        </ScrollViewer>


        <!-- FOOTER -->

        <Border Grid.Row="2"
            Background="{StaticResource HeaderFooterGradient}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="0,1,0,0"
            Panel.ZIndex="2">

            <Grid Margin="24,0">

                <TextBlock x:Name="SelectionText"
                       Text="0 selected"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryText}"
                       FontSize="12"/>

                <Button x:Name="RestoreOriginalButton"
                    Content="Restore Original"
                    Width="130"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="RestoreOriginalButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"/>

                <Button x:Name="GetAchievementButton"
                    Content="Get Achievement"
                    Width="150"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="GetAchievementButton_Click"
                    IsEnabled="False"
                    Style="{StaticResource PrimaryButtonStyle}"/>

            </Grid>

        </Border>

    </Grid>

</Window>