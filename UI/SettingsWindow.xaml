<Window x:Class="UbiSlot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UbiSlot Settings"
        Width="700"
        Height="720"
        MinWidth="620"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- COLORS        -->

        <SolidColorBrush x:Key="WindowBackground" Color="#101014"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#15151A"/>
        <SolidColorBrush x:Key="FieldBackground" Color="#24242C"/>
        <SolidColorBrush x:Key="HoverBackground" Color="#34343D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#332A3D"/>
        <SolidColorBrush x:Key="AccentColor" Color="#3D1B5D"/>
        <SolidColorBrush x:Key="AccentHoverColor" Color="#512878"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#F2F2F5"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#9A93A3"/>
        <SolidColorBrush x:Key="MutedText" Color="#7A7482"/>
        <SolidColorBrush x:Key="ToggleOffTrack" Color="#292931"/>
        <SolidColorBrush x:Key="ToggleKnob" Color="#EDEDF2"/>

        <DropShadowEffect x:Key="SettingsTitleGlow"
                           Color="#3D1B5D"
                           BlurRadius="2"
                           ShadowDepth="0"
                           Opacity="0.75"/>

        <LinearGradientBrush x:Key="HeaderFooterGradient"
                              StartPoint="0,0"
                              EndPoint="1,0">
            <GradientStop Color="#1B1420"
                          Offset="0"/>
            <GradientStop Color="#241A2E"
                          Offset="0.5"/>
            <GradientStop Color="#1B1420"
                          Offset="1"/>
        </LinearGradientBrush>


        <!-- SECTION HEADER-->

        <Style x:Key="SectionHeaderStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>

        </Style>


        <!-- SETTING TITLE                                           -->

        <Style x:Key="SettingTitleStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>

        </Style>


        <!-- SETTING DESCRIPTION                                     -->

        <Style x:Key="SettingDescriptionStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>

        </Style>

        <Style x:Key="SettingToggleStyle"
               TargetType="{x:Type ToggleButton}">

            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource ToggleOffTrack}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ToggleButton}">

                        <Grid Width="44"
                              Height="24">

                            <Border x:Name="ToggleTrack"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"/>

                            <Ellipse x:Name="ToggleKnob"
                                     Width="18"
                                     Height="18"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0"
                                     Fill="{DynamicResource ToggleKnob}"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="ToggleTrack"
                                        Property="Background"
                                        Value="{DynamicResource AccentColor}"/>

                                <Setter TargetName="ToggleTrack"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentColor}"/>

                                <Setter TargetName="ToggleKnob"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>

                                <Setter TargetName="ToggleKnob"
                                        Property="Margin"
                                        Value="0,0,3,0"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ToggleTrack"
                                        Property="Opacity"
                                        Value="0.92"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ToggleTrack"
                                        Property="Opacity"
                                        Value="0.78"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ToggleTrack"
                                        Property="Opacity"
                                        Value="0.45"/>

                                <Setter TargetName="ToggleKnob"
                                        Property="Opacity"
                                        Value="0.65"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- PRIMARY BUTTON                                          -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="{DynamicResource AccentHoverColor}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#2B133F"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBackground"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- SECONDARY BUTTON                                        -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>

                                <Setter TargetName="ButtonBackground"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentHoverColor}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#1C1C22"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- TEXT BOX                                                -->

        <Style x:Key="SettingsTextBoxStyle"
               TargetType="{x:Type TextBox}">

            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>

        <Style x:Key="SectionSeparatorStyle"
               TargetType="{x:Type Border}">

            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Margin" Value="0,22,0,22"/>

        </Style>

    </Window.Resources>


    <Grid Background="{DynamicResource WindowBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- HEADER                                                   -->

        <Border Grid.Row="0"
                Background="{StaticResource HeaderFooterGradient}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Panel.ZIndex="2">

            <Grid Margin="28,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Settings"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               Effect="{StaticResource SettingsTitleGlow}"/>

                    <TextBlock Text="Configure UbiSlot"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedText}"/>

                </StackPanel>

            </Grid>

        </Border>

        <Border Grid.Row="1"
                Height="50"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Panel.ZIndex="1">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0"
                                      EndPoint="0,1">

                    <GradientStop Color="#3A9D5CFF"
                                  Offset="0"/>

                    <GradientStop Color="#1C9D5CFF"
                                  Offset="0.25"/>

                    <GradientStop Color="#0A9D5CFF"
                                  Offset="0.55"/>

                    <GradientStop Color="#009D5CFF"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

        </Border>

        <Border Grid.Row="1"
                Height="36"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                Panel.ZIndex="1">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0"
                                      EndPoint="0,1">

                    <GradientStop Color="#009D5CFF"
                                  Offset="0"/>

                    <GradientStop Color="#0A9D5CFF"
                                  Offset="0.45"/>

                    <GradientStop Color="#1C9D5CFF"
                                  Offset="0.78"/>

                    <GradientStop Color="#289D5CFF"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,22">

            <StackPanel>

                <TextBlock Text="APPEARANCE"
                           Style="{StaticResource SectionHeaderStyle}"/>

                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Dark mode"
                                       Style="{StaticResource SettingTitleStyle}"/>

                            <TextBlock Text="Use the dark visual theme throughout UbiSlot."
                                       Style="{StaticResource SettingDescriptionStyle}"/>

                        </StackPanel>

                        <ToggleButton x:Name="DarkModeToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource SettingToggleStyle}"
                                      Checked="ThemeToggle_Checked"
                                      Unchecked="ThemeToggle_Unchecked"/>

                    </Grid>

                </Border>

                <Border Style="{StaticResource SectionSeparatorStyle}"/>

                <TextBlock Text="GAME CARDS"
                           Style="{StaticResource SectionHeaderStyle}"/>

                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="18">

                    <StackPanel>

                        <Grid Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Show game name"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <TextBlock Text="Display the Ubisoft game title below each cover."
                                           Style="{StaticResource SettingDescriptionStyle}"/>

                            </StackPanel>

                            <ToggleButton x:Name="ShowGameNameToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource SettingToggleStyle}"/>

                        </Grid>


                        <Grid Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Show completion percentage"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <TextBlock Text="Display the achievement completion percentage on each card."
                                           Style="{StaticResource SettingDescriptionStyle}"/>

                            </StackPanel>

                            <ToggleButton x:Name="ShowCompletionToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource SettingToggleStyle}"/>

                        </Grid>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Hide games with zero achievements"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <TextBlock Text="Hide games for which UbiSlot cannot find any achievement definitions."
                                           Style="{StaticResource SettingDescriptionStyle}"/>

                            </StackPanel>

                            <ToggleButton x:Name="HideZeroAchievementGamesToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource SettingToggleStyle}"/>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- BACKUPS                                              -->

                <Border Style="{StaticResource SectionSeparatorStyle}"/>

                <TextBlock Text="BACKUPS"
                           Style="{StaticResource SectionHeaderStyle}"/>

                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="18">

                    <StackPanel>

                        <TextBlock Text="UbiSlot backup folder"
                                   Style="{StaticResource SettingTitleStyle}"/>

                        <TextBlock Text="Choose where UbiSlot stores its protected backup copy."
                                   Style="{StaticResource SettingDescriptionStyle}"/>

                        <Grid Margin="0,12,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="BackupPathTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource SettingsTextBoxStyle}"
                                     Margin="0,0,8,0"/>

                            <Button Grid.Column="1"
                                    Content="Change"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ChangeBackupFolderButton_Click"
                                    Margin="0,0,8,0"/>

                            <Button Grid.Column="2"
                                    Content="Open Folder"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenBackupFolderButton_Click"/>

                        </Grid>

                        <TextBlock Text="Changing this location does not remove the original Ubisoft-side safety backup."
                                   Style="{StaticResource SettingDescriptionStyle}"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <Border Style="{StaticResource SectionSeparatorStyle}"/>

                <TextBlock Text="DATA"
                           Style="{StaticResource SectionHeaderStyle}"/>

                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Activity log"
                                       Style="{StaticResource SettingTitleStyle}"/>

                            <TextBlock Text="Delete UbiSlot.log and reset the pinned-game history reconstructed from it."
                                       Style="{StaticResource SettingDescriptionStyle}"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Delete Log"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="DeleteLogButton_Click"
                                VerticalAlignment="Center"/>

                    </Grid>

                </Border>

                <Border Style="{StaticResource SectionSeparatorStyle}"/>

                <TextBlock Text="UPDATES"
                           Style="{StaticResource SectionHeaderStyle}"/>

                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="18">

                    <StackPanel>

                        <Grid Margin="0,0,0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Check for updates automatically"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <TextBlock Text="Allow UbiSlot to check the public GitHub releases for newer versions."
                                           Style="{StaticResource SettingDescriptionStyle}"/>

                            </StackPanel>

                            <ToggleButton x:Name="AutoUpdateToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource SettingToggleStyle}"/>

                        </Grid>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">

                                <TextBlock x:Name="UpdateStatusText"
                                           Text="No update check performed."
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryText}"/>

                                <TextBlock x:Name="LastCheckedText"
                                           Text="Never checked"
                                           Margin="0,4,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource MutedText}"/>

                            </StackPanel>

                            <Button x:Name="CheckUpdatesButton"
                                    Grid.Column="1"
                                    Content="Check Now"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="CheckUpdatesButton_Click"
                                    VerticalAlignment="Center"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <TextBlock Text="UbiSlot v0.3.0-beta"
                           Margin="2,18,0,4"
                           FontSize="10"
                           Foreground="{DynamicResource MutedText}"/>

                <TextBlock Text="Settings are stored locally in UbiSlot_Cache."
                           FontSize="10"
                           Foreground="{DynamicResource MutedText}"/>

            </StackPanel>

        </ScrollViewer>


        <!-- FOOTER                                                   -->

        <Border Grid.Row="2"
                Background="{StaticResource HeaderFooterGradient}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0"
                Panel.ZIndex="2">

            <Grid Margin="28,0">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Content="Cancel"
                            Width="86"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseButton_Click"
                            Margin="0,0,8,0"/>

                    <Button Content="Save"
                            Width="86"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>