<Window x:Class="UbiSlot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UbiSlot"
        Icon="/UbiSlot;component/Games/UbiSlot.ico"
        Width="1200"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#101014"
        Foreground="White">

    <Window.Resources>

        <!-- REFRESH BUTTON -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="#3D1B5D"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="18,9"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBackground"
                                Background="#3D1B5D"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#512878"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#2B133F"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- SEARCH BUTTON -->

        <Style x:Key="SearchButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="34"/>

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#85858F"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="SearchButtonBackground"
                                Background="Transparent"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="SearchButtonBackground"
                                        Property="Background"
                                        Value="#24242C"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="SearchButtonBackground"
                                        Property="Background"
                                        Value="#34343D"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- GAME CARDS -->

        <Style x:Key="GameButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="6,8,6,20"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Top"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="GameCard"
                                Background="#3D1B5D"
                                CornerRadius="10"
                                Padding="12">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="GameCard"
                                        Property="Background"
                                        Value="#512878"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="GameCard"
                                        Property="Background"
                                        Value="#2B133F"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- SEARCH BOX -->

        <Style x:Key="SearchBoxStyle"
               TargetType="{x:Type TextBox}">

            <Setter Property="Background"
                    Value="#24242C"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#3D1B5D"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,7"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#15151A"
                BorderBrush="#292931"
                BorderThickness="0,0,0,1">

            <Grid Margin="28,0">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="UbiSlot"
                               FontSize="25"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Ubisoft Achievement Unlocker"
                               Margin="14,5,0,0"
                               Foreground="#85858F"
                               FontSize="13"/>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="SearchButton"
                            Click="SearchButton_Click"
                            Style="{StaticResource SearchButtonStyle}">

                        <Grid Width="20"
                              Height="20">

                            <Ellipse Width="12"
                                     Height="12"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Margin="1,1,0,0"
                                     Stroke="White"
                                     StrokeThickness="2"/>

                            <Rectangle Width="8"
                                       Height="2"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="11,13,0,0"
                                       Fill="White"
                                       RadiusX="1"
                                       RadiusY="1"
                                       RenderTransformOrigin="0,0.5">

                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Rectangle.RenderTransform>

                            </Rectangle>

                        </Grid>

                    </Button>

                    <Button Content="Refresh"
                            Width="90"
                            Height="32"
                            Margin="8,0,0,0"
                            Click="RefreshButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                </StackPanel>


                <!-- SEARCH POPUP -->

                <Popup x:Name="SearchPopup"
                        PlacementTarget="{Binding ElementName=SearchButton}"
                        Placement="Bottom"
                        HorizontalOffset="-226"
                        VerticalOffset="6"
                        AllowsTransparency="True"
                        StaysOpen="True"
                        Closed="SearchPopup_Closed">

                    <Border Width="260"
                            Height="42"
                            Background="#24242C"
                            BorderBrush="#3D1B5D"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="2">

                        <Border.RenderTransform>

                            <TranslateTransform x:Name="SearchTransform"
                                                Y="-8"/>

                        </Border.RenderTransform>

                        <Border.Triggers>

                            <EventTrigger RoutedEvent="Loaded">

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="SearchTransform"
                                            Storyboard.TargetProperty="Y"
                                            From="-8"
                                            To="0"
                                            Duration="0:0:0.15"/>

                                    </Storyboard>

                                </BeginStoryboard>

                            </EventTrigger>

                        </Border.Triggers>

                        <TextBox x:Name="GameSearchBox"
                                 KeyDown="GameSearchBox_KeyDown"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 FontSize="13"
                                 Padding="10,5"
                                 VerticalContentAlignment="Center"
                                 TextChanged="GameSearchBox_TextChanged"/>

                    </Border>

                </Popup>

            </Grid>

        </Border>


        <!-- MAIN CONTENT -->

        <Grid Grid.Row="1"
              Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0"
                        Margin="0,0,0,18">

                <TextBlock Text="Your Games"
                           FontSize="22"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="GameCountText"
                           Text="Scanning... (2 mins. max)"
                           Margin="0,6,0,0"
                           Foreground="#85858F"
                           FontSize="13"/>

            </StackPanel>


            <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Margin="0,0,0,0">

                <UniformGrid x:Name="GameGrid"
                 Columns="5"
                 HorizontalAlignment="Stretch"/>
            </ScrollViewer>
        </Grid>


        <!-- FOOTER -->

        <Border Grid.Row="2"
                Background="#15151A"
                BorderBrush="#292931"
                BorderThickness="0,1,0,0">

            <Grid Margin="28,0">

                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           VerticalAlignment="Center"
                           Foreground="#666670"
                           FontSize="11"/>


                <Button Content="Support"
                        Click="SupportButton_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Foreground="#666670"
                        BorderThickness="0"
                        Padding="8,4"
                        FontSize="11"
                        Cursor="Hand"
                        Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>


                <TextBlock Text="UbiSlot v0.1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#666670"
                           FontSize="11"/>

            </Grid>

        </Border>

    </Grid>

</Window>