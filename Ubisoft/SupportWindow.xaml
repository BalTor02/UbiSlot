<Window x:Class="UbiSlot.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Support"
        Width="430"
        Height="430"
        MinWidth="430"
        MinHeight="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#15161C">

    <Window.Resources>

        <Style x:Key="GitHubButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#252631"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#3A3B48"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="12,8"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#30313E"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#20212A"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- Title -->

        <TextBlock Grid.Row="0"
                   Text="Support"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,28"/>



        <!-- Credits -->

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center">

            <TextBlock Text="Credits"
           FontSize="16"
           FontWeight="SemiBold"
           Foreground="White"
           HorizontalAlignment="Center"
           Margin="0,0,0,18"/>

            <TextBlock Text="BalTor"
           FontSize="14"
           FontWeight="SemiBold"
           Foreground="#DADAE2"
           HorizontalAlignment="Center"/>

            <TextBlock Text="UbiSlot Developer"
           FontSize="12"
           Foreground="#9697A3"
           TextAlignment="Center"
           HorizontalAlignment="Center"
           Margin="0,3,0,16"/>

            <TextBlock Text="NikitaGareev"
           FontSize="14"
           FontWeight="SemiBold"
           Foreground="#DADAE2"
           HorizontalAlignment="Center"/>

            <TextBlock Text="Uplay Game ID"
           FontSize="12"
           Foreground="#9697A3"
           TextAlignment="Center"
           HorizontalAlignment="Center"
           Margin="0,3,0,16"/>

            <TextBlock Text="PSerban93"
           FontSize="14"
           FontWeight="SemiBold"
           Foreground="#DADAE2"
           HorizontalAlignment="Center"/>

            <TextBlock Text="Ubisoft achievement data extraction technique"
           FontSize="12"
           Foreground="#9697A3"
           TextAlignment="Center"
           HorizontalAlignment="Center"
           Margin="0,3,0,16"/>

        </StackPanel>


        <!-- GitHub Sponsors -->

        <Button x:Name="GitHubSponsorsButton"
                Grid.Row="2"
                Width="170"
                Height="42"
                HorizontalAlignment="Center"
                Click="GitHubSponsorsButton_Click"
                Style="{StaticResource GitHubButtonStyle}">

            <StackPanel Orientation="Horizontal">

                <!-- GitHub mark -->

                <Viewbox Width="20"
                         Height="20"
                         Margin="0,0,9,0">

                    <Canvas Width="24"
                            Height="24">

                        <Path Fill="White"
                              Data="M12,2C6.48,2 2,6.48 2,12C2,16.42 4.87,20.17 8.84,21.49C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.49,20.14 9.49,19.31C6.73,19.91 6.14,17.98 6.14,17.98C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.89 5.1,15.89C6.1,15.96 6.63,16.92 6.63,16.92C7.52,18.45 8.97,18.01 9.52,17.76C9.61,17.11 9.87,16.67 10.15,16.42C7.95,16.17 5.64,15.32 5.64,11.07C5.64,9.86 6.07,8.87 6.77,8.09C6.66,7.84 6.26,6.72 6.87,5.2C6.87,5.2 7.78,4.91 9.47,6.05C10.34,5.81 11.26,5.69 12.18,5.69C13.1,5.69 14.02,5.81 14.89,6.05C16.58,4.91 17.49,5.2 17.49,5.2C18.1,6.72 17.7,7.84 17.59,8.09C18.29,8.87 18.72,9.86 18.72,11.07C18.72,15.33 16.41,16.16 14.2,16.41C14.55,16.71 14.86,17.3 14.86,18.2C14.86,19.49 14.85,20.53 14.85,21C14.85,21.27 15.01,21.58 15.51,21.49C19.48,20.17 22.35,16.42 22.35,12C22.35,6.48 17.87,2 12.35,2H12Z"/>

                    </Canvas>

                </Viewbox>

                <TextBlock Text="Support me on GitHub"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Button>

    </Grid>

</Window>